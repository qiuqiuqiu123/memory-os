# Copy to .env. Replace passwords and API_KEY before starting.
API_KEY=replace-with-a-long-random-memory-api-key
POSTGRES_PASSWORD=replace-with-a-random-database-password
# Required for stable encrypted model settings; keep it with database backups.
SETTINGS_ENCRYPTION_KEY=
# Optional override; use a PostgreSQL URI with URL-encoded credentials.
# DATABASE_URL=postgresql://memory:password@postgres:5432/memory
API_BIND=127.0.0.1
API_PORT=8000

# LLM and embedding are independent OpenAI-compatible endpoints.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
# Only enable for providers/models accepting the optional dimensions argument.
EMBEDDING_SEND_DIMENSIONS=false
QDRANT_COLLECTION=memory_os

# Optional Langfuse profile. Replace ALL placeholders before enabling it.
# External Langfuse is also supported: set LANGFUSE_BASE_URL to its URL.
LANGFUSE_BASE_URL=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROJECT_ID=memory-os
LANGFUSE_USER_ID=default
LANGFUSE_SCOPE=default
LANGFUSE_UI_URL=http://localhost:3000
LANGFUSE_BIND=127.0.0.1
LANGFUSE_PORT=3000
LANGFUSE_POSTGRES_PASSWORD=replace-with-another-database-password
LANGFUSE_NEXTAUTH_SECRET=replace-with-a-random-session-secret
LANGFUSE_SALT=replace-with-a-random-salt
# Required format: 64 hexadecimal characters. Generate: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=
CLICKHOUSE_PASSWORD=replace-with-a-clickhouse-password
REDIS_PASSWORD=replace-with-a-redis-password
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=replace-with-a-minio-password
# Browser-reachable URL; use SSH tunnelling or a reverse proxy for remote access.
MINIO_PUBLIC_URL=http://localhost:9090
MINIO_PORT=9090
MINIO_CONSOLE_PORT=9091

# Optional first-start headless Langfuse setup. Otherwise create a user/project
# in Langfuse UI and put its API keys into LANGFUSE_PUBLIC_KEY / SECRET_KEY.
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=

# Optional extra credentials. Every key is bound to exactly one user_id.
# API_KEYS_JSON={"another-local-key":"another-user"}
# For an MCP reverse proxy hostname, append its exact host:port here.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,api:*

# Optional local CPU embedding service: merge compose.bge.yml after docker-compose.yml.
# Required only when enabling that overlay. Generate a separate internal secret.
# MEMORY_OS_BGE_KEY=replace-with-a-long-random-internal-embedding-key
# The overlay sets API/worker embedding URL/model/key/dimensions automatically:
# http://bge-m3:8080/v1, BAAI/bge-m3, 1024 dimensions, send_dimensions=false.
# BGE_SOURCE=huggingface
# HF_ENDPOINT=https://hf-mirror.com
# BGE_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# Alternative source for environments unable to reach Hugging Face:
# BGE_SOURCE=modelscope
# BGE_MODELSCOPE_REVISION=e44369c5623cc146f016da906583db4ee0e3488d
# BGE_MAX_LENGTH=512
# BGE_BATCH_SIZE=2
# BGE_THREADS=2
# Build-only Python package index; CPU Torch wheels use the Dockerfile's source.
# PIP_INDEX_URL=https://pypi.org/simple
